# Trading212 API Configuration
# Get your API credentials from the Trading212 dashboard
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here

# Trading212 Environment: "demo" or "live"
T212_ENV=demo

# Alternative: Use ISA-specific credentials if available
# T212_API_KEY_STOCKS_ISA=your_stocks_isa_key_here
# T212_API_SECRET_STOCKS_ISA=your_stocks_isa_secret_here
# T212_ENV_STOCKS_ISA=demo
